# MCP transport
HOST=127.0.0.1
PORT=8010
MCP_PUBLIC_HOST=mcp-googleads.hangdoistudio.vn
MCP_BEARER_TOKEN=replace-with-long-random-token

# Google Ads API (post-2026-09-09: access level is attached to the Google Cloud project)
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_SERVICE_ACCOUNT_FILE=/run/secrets/google-ads-service-account.json
GOOGLE_ADS_ALLOWED_CUSTOMERS=8681228450
# Optional when access is through an MCC. No hyphens.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Mutation guardrails, values are in the Ads account currency
GOOGLE_ADS_MAX_DAILY_BUDGET=5000000
GOOGLE_ADS_MAX_BUDGET_INCREASE_PCT=20
GOOGLE_ADS_HTTP_TIMEOUT_SECONDS=30
